// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Modelo de Usuário (proprietário do estabelecimento)
model User {
  id            String    @id @default(uuid())
  email         String    @unique
  password      String
  name          String
  phone         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  establishment Establishment?
  subscription  Subscription?
  passwordResets PasswordReset[]
  notifications Notification[]

  @@map("users")
}

// Modelo de Token de Recuperacao de Senha
model PasswordReset {
  id        String   @id @default(uuid())
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@map("password_resets")
}

// Modelo de Estabelecimento
model Establishment {
  id              String    @id @default(uuid())
  name            String
  slug            String    @unique
  description     String?
  address         String?
  phone           String?
  email           String?
  logo            String?
  
  // Horários de funcionamento (JSON com dias da semana)
  businessHours   Json?
  
  // Configurações adicionais
  timezone        String    @default("America/Sao_Paulo")
  slotDuration    Int       @default(30) // Duração padrão do slot em minutos
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relacionamentos
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  professionals   Professional[]
  services        Service[]
  clients         Client[]
  appointments    Appointment[]
  automaticMessageSettings AutomaticMessageSettings?
  notifications   Notification[]

  @@map("establishments")
}

// Modelo de Profissional
model Professional {
  id              String    @id @default(uuid())
  name            String
  email           String?
  phone           String?
  avatar          String?
  bio             String?
  active          Boolean   @default(true)
  
  // Horários de trabalho específicos do profissional (opcional, usa do estabelecimento se não definido)
  workingHours    Json?
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relacionamentos
  establishmentId String
  establishment   Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  
  appointments    Appointment[]
  services        ProfessionalService[]

  @@map("professionals")
}

// Modelo de Serviço
model Service {
  id              String    @id @default(uuid())
  name            String
  description     String?
  duration        Int       // Duração em minutos
  price           Decimal   @db.Decimal(10, 2)
  active          Boolean   @default(true)
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relacionamentos
  establishmentId String
  establishment   Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  
  appointments    Appointment[]
  professionals   ProfessionalService[]

  @@map("services")
}

// Tabela de relacionamento entre Profissional e Serviço
model ProfessionalService {
  id              String    @id @default(uuid())
  professionalId  String
  serviceId       String
  
  professional    Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  service         Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([professionalId, serviceId])
  @@map("professional_services")
}

// Modelo de Cliente
model Client {
  id              String    @id @default(uuid())
  name            String
  email           String?
  phone           String
  notes           String?
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relacionamentos
  establishmentId String
  establishment   Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  
  appointments    Appointment[]
  messageLogs     MessageLog[]

  @@unique([phone, establishmentId])
  @@map("clients")
}

// Modelo de Agendamento
model Appointment {
  id              String            @id @default(uuid())
  date            DateTime          @db.Date
  startTime       DateTime          @db.Time()
  endTime         DateTime          @db.Time()
  status          AppointmentStatus @default(PENDING)
  notes           String?
  
  // Preço no momento do agendamento (pode diferir do preço atual do serviço)
  price           Decimal           @db.Decimal(10, 2)
  
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  // Relacionamentos
  establishmentId String
  establishment   Establishment     @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  
  clientId        String
  client          Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  
  professionalId  String
  professional    Professional      @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  
  serviceId       String
  service         Service           @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  
  messageLogs     MessageLog[]

  @@index([establishmentId, date])
  @@index([professionalId, date])
  @@map("appointments")
}

// Status do Agendamento
enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

// Modelo de Plano de Assinatura
model Plan {
  id              String    @id @default(uuid())
  name            String
  description     String?
  price           Decimal   @db.Decimal(10, 2)
  interval        PlanInterval @default(MONTHLY)
  
  // Limites do plano
  maxProfessionals Int       @default(1)
  maxServices      Int       @default(10)
  maxAppointments  Int       @default(100) // Por mês
  
  // Features do plano (JSON com lista de features)
  features        Json?
  
  // Trial em dias (0 = sem trial)
  trialDays       Int       @default(0)
  
  active          Boolean   @default(true)
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  subscriptions   Subscription[]

  @@map("plans")
}

// Intervalo do Plano
enum PlanInterval {
  MONTHLY
  YEARLY
}

// Modelo de Assinatura
model Subscription {
  id                    String             @id @default(uuid())
  status                SubscriptionStatus @default(INACTIVE)
  
  startDate             DateTime?
  endDate               DateTime?
  cancelledAt           DateTime?
  trialEndsAt           DateTime?          // Data fim do trial
  
  // ID da assinatura no gateway de pagamento (Stripe, Mercado Pago, etc.)
  gatewaySubscriptionId String?
  gatewayCustomerId     String?
  
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  // Relacionamentos
  userId                String             @unique
  user                  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  planId                String
  plan                  Plan               @relation(fields: [planId], references: [id])

  @@map("subscriptions")
}

// Status da Assinatura
enum SubscriptionStatus {
  ACTIVE
  INACTIVE
  CANCELLED
  PAST_DUE
  TRIALING
}

// Modelo de Configuracoes de Mensagens Automaticas
model AutomaticMessageSettings {
  id                    String    @id @default(uuid())
  activeMessages        String[]  @default([])
  whatsappInstanceName  String?
  whatsappConnected     Boolean   @default(false)
  whatsappPhone         String?
  
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  establishmentId       String    @unique
  establishment         Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)

  messageLogs           MessageLog[]

  @@map("automatic_message_settings")
}

// Modelo de Log de Mensagens Enviadas
model MessageLog {
  id              String           @id @default(uuid())
  messageType     String           // confirmation, reminder_24h, reminder_1h, etc
  recipientPhone  String
  recipientName   String?
  content         String?
  status          MessageLogStatus @default(PENDING)
  sentAt          DateTime?
  error           String?
  
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  settingsId      String
  settings        AutomaticMessageSettings @relation(fields: [settingsId], references: [id], onDelete: Cascade)
  
  clientId        String?
  client          Client?          @relation(fields: [clientId], references: [id], onDelete: SetNull)
  
  appointmentId   String?
  appointment     Appointment?     @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([settingsId, createdAt])
  @@index([messageType])
  @@index([status])
  @@map("message_logs")
}

// Status do Log de Mensagem
enum MessageLogStatus {
  PENDING
  SENT
  FAILED
}

// Modelo de Notificacao
model Notification {
  id              String    @id @default(uuid())
  type            String    // appointment_created, appointment_cancelled, appointment_reminder, client_created, whatsapp_disconnected
  title           String
  message         String
  data            Json?     // dados extras (appointmentId, clientId, etc)
  read            Boolean   @default(false)
  
  createdAt       DateTime  @default(now())

  establishmentId String
  establishment   Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  
  userId          String?   // null = notificacao para todos do estabelecimento
  user            User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([establishmentId, read, createdAt])
  @@map("notifications")
}

// Modelo de Audit Log (OWASP A09 - Security Logging)
model AuditLog {
  id              String    @id @default(uuid())
  action          String    // LOGIN_SUCCESS, LOGIN_FAILED, etc
  severity        String    @default("LOW") // LOW, MEDIUM, HIGH, CRITICAL
  
  userId          String?
  establishmentId String?
  
  ipAddress       String?
  userAgent       String?
  
  resourceType    String?   // appointment, professional, service, etc
  resourceId      String?
  
  details         String?   // JSON com detalhes adicionais
  
  createdAt       DateTime  @default(now())

  @@index([action, createdAt])
  @@index([userId, createdAt])
  @@index([establishmentId, createdAt])
  @@index([severity, createdAt])
  @@map("audit_logs")
}

// Modelo para controle de tentativas de login (Account Lockout)
model LoginAttempt {
  id              String    @id @default(uuid())
  email           String
  ipAddress       String
  success         Boolean
  createdAt       DateTime  @default(now())

  @@index([email, createdAt])
  @@index([ipAddress, createdAt])
  @@map("login_attempts")
}
